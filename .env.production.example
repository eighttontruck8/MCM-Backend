# Copy to .env.production and replace every example/placeholder value before deployment.
M_JOURNEY_ENVIRONMENT=production
M_JOURNEY_DATABASE_URL=postgresql+psycopg://mjourney:replace-with-db-password@db:5432/mjourney
M_JOURNEY_PUBLIC_API_BASE_URL=https://api.example.com
M_JOURNEY_FRONTEND_BASE_URL=https://app.example.com
M_JOURNEY_CORS_ORIGINS=https://app.example.com
M_JOURNEY_JWT_SECRET=<generate-at-least-32-random-characters>
M_JOURNEY_DEMO_PASSWORD=<set-a-strong-demo-password>
M_JOURNEY_DEMO_QR_TOKEN=<generate-at-least-24-random-characters>
M_JOURNEY_AUTO_CREATE_SCHEMA=false
M_JOURNEY_SEED_DEMO_DATA=true

POSTGRES_DB=mjourney
POSTGRES_USER=mjourney
POSTGRES_PASSWORD=<replace-with-db-password>

M_JOURNEY_AI_PROVIDER=rule_based
M_JOURNEY_OPENAI_API_KEY=
M_JOURNEY_OPENAI_MODEL=gpt-4o-mini
M_JOURNEY_SMTP_HOST=
M_JOURNEY_SMTP_PORT=587
M_JOURNEY_SMTP_USERNAME=
M_JOURNEY_SMTP_PASSWORD=
M_JOURNEY_SMTP_FROM=
M_JOURNEY_SMTP_STARTTLS=true
M_JOURNEY_SMTP_USE_SSL=false
