M_JOURNEY_DATABASE_URL=sqlite:///./mjourney.db
# PostgreSQL: postgresql+psycopg://user:password@host:5432/mjourney
M_JOURNEY_ENVIRONMENT=development
M_JOURNEY_CORS_ORIGINS=http://localhost:5173
M_JOURNEY_JWT_SECRET=<generate-a-long-random-secret>
M_JOURNEY_DEMO_PASSWORD=<set-a-demo-password>
M_JOURNEY_ACCESS_TOKEN_EXPIRE_MINUTES=30
M_JOURNEY_REFRESH_TOKEN_EXPIRE_DAYS=7
M_JOURNEY_AI_TIMEOUT_SECONDS=10
M_JOURNEY_AI_MAX_RETRIES=1
M_JOURNEY_AI_PROVIDER=rule_based
M_JOURNEY_OPENAI_API_KEY=
M_JOURNEY_OPENAI_MODEL=gpt-4o-mini
M_JOURNEY_OPENAI_BASE_URL=https://api.openai.com/v1
M_JOURNEY_VISIT_PERSONAL_DATA_RETENTION_DAYS=90
M_JOURNEY_EXPIRED_AUTH_TOKEN_RETENTION_DAYS=7
M_JOURNEY_AUDIT_LOG_RETENTION_DAYS=365
M_JOURNEY_PASSWORD_RESET_EXPIRE_MINUTES=15
M_JOURNEY_EXPOSE_PASSWORD_RESET_TOKEN=false
M_JOURNEY_RATE_LIMIT_WINDOW_SECONDS=60
M_JOURNEY_LOGIN_RATE_LIMIT=10
M_JOURNEY_PASSWORD_RESET_RATE_LIMIT=5
M_JOURNEY_AI_RATE_LIMIT=10
M_JOURNEY_FRONTEND_BASE_URL=http://localhost:5173
M_JOURNEY_DEMO_QR_TOKEN=<set-a-long-random-demo-token>
M_JOURNEY_AUTO_CREATE_SCHEMA=true
M_JOURNEY_SEED_DEMO_DATA=true
M_JOURNEY_SMTP_HOST=
M_JOURNEY_SMTP_PORT=587
M_JOURNEY_SMTP_USERNAME=
M_JOURNEY_SMTP_PASSWORD=
M_JOURNEY_SMTP_FROM=
M_JOURNEY_SMTP_STARTTLS=true
M_JOURNEY_SMTP_USE_SSL=false
